{
  "manifest_version": 3,
  "name": "OmniStream - Video & MP3 Downloader",
  "version": "3.2.3",
  "description": "Capturador universal de video MP4 (con fusión automática de Video + Audio vía FFmpeg/yt-dlp) y extractor de audio MP3.",
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "cookies",
    "storage",
    "downloads",
    "offscreen",
    "activeTab",
    "tabs",
    "sidePanel",
    "nativeMessaging"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OmniStream Video & MP3 Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
